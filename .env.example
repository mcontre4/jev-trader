# Copy to .env at the repository root. Never use VITE_ for any secret.
# One personal Coinbase Advanced account, already approved for US CFM futures.
COINBASE_API_KEY=organizations/your-org/apiKeys/your-key
# CDP ECDSA (ES256) private key. Preserve literal \n inside the quoted value.
COINBASE_API_SECRET="-----BEGIN EC PRIVATE KEY-----\nREPLACE_ME\n-----END EC PRIVATE KEY-----\n"
JEV_API_KEY=
JEV_MODEL=jev-latest
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
TERMINAL_TOKEN=

MYSQL_DATABASE=jev_trader
MYSQL_USER=jev
MYSQL_PASSWORD=replace-with-a-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-password
# Local development URL. URL-encode special characters in the password.
# Docker Compose overrides this URL with its internal mysql hostname.
DATABASE_URL=mysql+pymysql://jev:replace-with-a-random-password@127.0.0.1:3307/jev_trader

TRADING_ASSET=BTC
# Empty means discover the smallest eligible CFM contract and pin it for this process.
# Pin the verified product ID here before live operation to keep it stable across restarts.
TRADING_PRODUCT_ID=
TRADING_MODE=preview
# Set only after verifying your account is eligible for US CFM futures.
TRADING_CFM_CONFIRMED=false
TRADING_AUTOSTART=true
TRADING_MARGIN_USD=1
TRADING_MAX_POSITION_USD=10
TRADING_MAX_DAILY_LOSS_USD=5
TRADING_MIN_CONFIDENCE=0.6
TRADING_FEE_RESERVE_USD=0.10
TRADING_SLIPPAGE_BPS=10
